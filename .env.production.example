EXPO_PUBLIC_APP_ORIGIN=https://reelyou.onrender.com
EXPO_PUBLIC_ENABLE_DEMO_MODE=0
EXPO_PUBLIC_ENABLE_EXPLORE_DEMO=0
EXPO_PUBLIC_FRIEND_DISCOVERY_DEV_FIXTURES=0
