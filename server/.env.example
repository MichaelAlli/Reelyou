# Copy to server/.env — never commit .env
PORT=8787
# Required for beta friend discovery + sessions (>= 32 chars each; set via deployment secrets only)
AUTH_JWT_SECRET=
FRIEND_MATCH_PEPPER=
# Beta/production: set Render (or other) Postgres URL — required for persistence across deploys
DATABASE_URL=
# Local dev only when DATABASE_URL is empty:
REELYOU_DB_PATH=./data/accounts.json
# Media — production requires MEDIA_STORAGE=s3 (Cloudflare R2 or AWS S3-compatible)
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=./data/media
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_TTL_SEC=900
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=280
OPENAI_DAILY_REQUEST_BUDGET=500
CORS_ORIGIN=http://localhost:8081,http://localhost:8090,http://localhost:8094,http://localhost:8096
# Optional comma-separated RSS feeds (public, authorized for your deployment)
RESOURCE_RSS_URLS=
ARXIV_ENABLED=true
GRANTS_GOV_ENABLED=true
