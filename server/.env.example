# Copy to server/.env — never commit .env
PORT=8787
# Required for beta friend discovery + sessions (>= 32 chars each; set via deployment secrets only)
AUTH_JWT_SECRET=
FRIEND_MATCH_PEPPER=
REELYOU_DB_PATH=./data/accounts.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=280
OPENAI_DAILY_REQUEST_BUDGET=500
CORS_ORIGIN=http://localhost:8090,http://localhost:8094,http://localhost:8096
# Optional comma-separated RSS feeds (public, authorized for your deployment)
RESOURCE_RSS_URLS=
ARXIV_ENABLED=true
GRANTS_GOV_ENABLED=true
