# Expo public — safe in client bundle (no secrets)
EXPO_PUBLIC_REELYOU_API_URL=http://localhost:8787
# Public web origin (informational; server APP_ORIGIN drives reset email links)
EXPO_PUBLIC_APP_ORIGIN=http://localhost:8081
# Enable server-backed signup/login + friend discovery (requires AUTH_JWT_SECRET + FRIEND_MATCH_PEPPER on server)
# Set to false only to use offline mock owner without server sessions
EXPO_PUBLIC_REELYOU_AUTH_ENABLED=true
# Dev-only: set to 1 to enable Michael demo fixtures (never for Beta builds)
EXPO_PUBLIC_ENABLE_DEMO_MODE=0
# Dev-only: isolated contact fixtures when auth/server matching is off (__DEV__ only)
EXPO_PUBLIC_FRIEND_DISCOVERY_DEV_FIXTURES=0
# Dev-only: show Explore demo skies (__DEV__ + flag)
EXPO_PUBLIC_ENABLE_EXPLORE_DEMO=0
# Google OAuth client id — People API + contacts.readonly (separate from sign-in)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Facebook — keep disabled until Meta app review approves friend discovery
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_FRIEND_DISCOVERY_ENABLED=false
