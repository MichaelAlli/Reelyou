# Expo public — safe in client bundle (no secrets)
EXPO_PUBLIC_REELYOU_API_URL=http://localhost:8787
# HTTPS app origin for invitation links in production (required for release invite sharing)
EXPO_PUBLIC_APP_ORIGIN=
# Dev-only isolated contact match fixtures when the server is not running
EXPO_PUBLIC_FRIEND_DISCOVERY_DEV_FIXTURES=1
# Google OAuth client id — People API + contacts.readonly (separate from sign-in)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Facebook — keep disabled until Meta app review approves friend discovery
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_FRIEND_DISCOVERY_ENABLED=false
